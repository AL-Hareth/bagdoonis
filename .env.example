# Any OpenAI-compatible provider with a vision model.
# Groq (free tier): https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
# Optional: tried if the primary model errors or is rate-limited. Must support images.
AI_FALLBACK_MODEL=

# OpenRouter alternative:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=<a :free vision model, see https://openrouter.ai/models?input_modalities=image&max_price=0>
