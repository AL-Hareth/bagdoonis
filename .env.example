# Each photo is sent to every provider with a key; the verdict is decided by vote.
# Leave a key empty to skip that provider. All three have free tiers.

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
# (free models need free-endpoint data policies enabled at https://openrouter.ai/settings/privacy)
OPENROUTER_API_KEY=

# Optional model overrides (must accept image input):
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.5-flash
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
